#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Último paso de la instalación: deja el resolv.conf original, configura Snapper sobre el
# subvolumen @snapshots, crea la instantánea inicial y regenera el menú de GRUB para que aparezca
# (D-04). Lo ejecuta Calamares (shellprocess@finish) desde la live.
set -euo pipefail

root="${1:?uso: $0 <raíz-del-destino>}"
snapshots="${root}/.snapshots"

in_target() { chroot "$root" "$@"; }

# prepare-target puso el resolv.conf de la live para que pacman tuviera DNS.
if [[ -e "${root}/etc/resolv.conf.arctiva-orig" ]]; then
    mv -f -- "${root}/etc/resolv.conf.arctiva-orig" "${root}/etc/resolv.conf"
fi

# [arctiva] se añade al final y no antes de instalar paquetes: así la instalación no depende de que
# GitHub responda. El servidor vive en /etc/pacman.d/arctiva-mirrorlist, que instala arctiva-settings.
if ! grep -q '^\[arctiva\]' "${root}/etc/pacman.conf"; then
    printf '\n[arctiva]\nInclude = /etc/pacman.d/arctiva-mirrorlist\n' >>"${root}/etc/pacman.conf"
fi

# En el modo manual el usuario puede haber elegido otro sistema de archivos: sin Btrfs no hay instantáneas.
if [[ "$(findmnt -no FSTYPE -- "$root")" != btrfs ]]; then
    echo "La raíz no es Btrfs: no se configura Snapper."
    exit 0
fi
if ! mountpoint -q -- "$snapshots"; then
    echo "No hay subvolumen @snapshots en /.snapshots: no se configura Snapper."
    exit 0
fi

# «snapper create-config» falla si /.snapshots ya existe, y crea su propio subvolumen dentro de @.
# Se desmonta @snapshots, se deja que Snapper cree la configuración, se borra su subvolumen y se
# vuelve a montar @snapshots en su lugar.
source_dev="$(findmnt -no SOURCE -- "$snapshots")"
source_dev="${source_dev%%\[*}"
umount -- "$snapshots"
rmdir -- "$snapshots"
in_target snapper --no-dbus -c root create-config /
btrfs subvolume delete -- "$snapshots"
mkdir -- "$snapshots"
mount -o subvol=/@snapshots -- "$source_dev" "$snapshots"
chmod 750 -- "$snapshots"

# Los usuarios del grupo wheel pueden ver las instantáneas sin sudo. Sin instantáneas por horas:
# solo las de snap-pac (antes y después de cada transacción de pacman). Límite de 10 (5 las
# importantes) que aplica snapper-cleanup.timer; sin FREE_LIMIT/SPACE_LIMIT, que exigen cuotas
# de Btrfs y ralentizan el disco.
in_target snapper --no-dbus -c root set-config ALLOW_GROUPS=wheel SYNC_ACL=yes TIMELINE_CREATE=no     NUMBER_CLEANUP=yes NUMBER_LIMIT=10 NUMBER_LIMIT_IMPORTANT=5

# Descripción sin tildes: grub-btrfs las muestra como entidades HTML en el menú.
in_target snapper --no-dbus -c root create --description "Arctiva: estado inicial"

# Sin esto el submenú toma el nombre de os-release («Arch Linux snapshots»).
echo 'GRUB_BTRFS_SUBMENUNAME="Arctiva snapshots"' >>"${root}/etc/default/grub-btrfs/config"

# grub-btrfs añade el submenú de instantáneas solo si encuentra alguna al generar grub.cfg.
in_target grub-mkconfig -o /boot/grub/grub.cfg
