#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Prepara el sistema copiado de la live, antes de generar los initramfs.
# Lo ejecuta Calamares (shellprocess@prepare) desde la live, con la raíz del destino montada.
set -euo pipefail

root="${1:?uso: $0 <raíz-del-destino>}"
[[ -d "${root}/usr/lib/modules" ]] || { echo "prepare-target: ${root} no parece un sistema instalado." >&2; exit 1; }

in_target() { chroot "$root" "$@"; }

# mkarchiso vacía /boot y el kernel va aparte en la ISO. Se copia igual que lo hace el hook de
# pacman de mkinitcpio, desde /usr/lib/modules/<versión>/vmlinuz.
# Sin huecos: unpackfs copia con rsync -S y la cola de ceros del kernel queda como hueco implícito
# (Btrfs con NO_HOLES); GRUB lo toma por el final del archivo y falla con «premature end of file».
# También se reescribe el origen, porque el hook de mkinitcpio lo vuelve a copiar a /boot.
dense_copy() {
    local tmp
    tmp="$(dirname -- "$2")/.$(basename -- "$2").arctiva-tmp"
    cp --sparse=never --preserve=mode,timestamps -- "$1" "$tmp"
    mv -f -- "$tmp" "$2"
}
found=0
for pkgbase_file in "${root}"/usr/lib/modules/*/pkgbase; do
    [[ -e "$pkgbase_file" ]] || continue
    read -r pkgbase <"$pkgbase_file"
    src="${pkgbase_file%/pkgbase}/vmlinuz"
    dense_copy "$src" "$src"
    install -d -m755 -- "${root}/boot"
    dense_copy "$src" "${root}/boot/vmlinuz-${pkgbase}"
    chmod 644 -- "${root}/boot/vmlinuz-${pkgbase}"
    echo "Kernel copiado: /boot/vmlinuz-${pkgbase}"
    found=1
done
(( found )) || { echo "prepare-target: no hay ningún kernel en /usr/lib/modules." >&2; exit 1; }

# Paquetes que solo sirven en la live. -s quita también sus dependencias huérfanas (kpmcore, ckbcomp…).
# Discover tampoco va en el sistema instalado (D-07): la tienda será la de Arctiva Center.
live_only=(arctiva-calamares-config calamares mkinitcpio-archiso discover)
mapfile -t installed < <(in_target pacman -Qq "${live_only[@]}" 2>/dev/null || true)
if (( ${#installed[@]} )); then
    in_target pacman -Rns --noconfirm -- "${installed[@]}"
fi

# La imagen trae el resolv.conf genérico: sin el de la live, pacman no resuelve nombres dentro del
# chroot. finish-target deja el original al terminar (en el sistema instalado lo gestiona NetworkManager).
if [[ ! -e "${root}/etc/resolv.conf.arctiva-orig" ]]; then
    cp -a -- "${root}/etc/resolv.conf" "${root}/etc/resolv.conf.arctiva-orig"
fi
cp --remove-destination -L -- /etc/resolv.conf "${root}/etc/resolv.conf"

# multilib de serie (D-11): lo necesita el perfil Juegos y packages hace -Syu antes de instalar.
# Idempotente: descomenta el bloque si está comentado y lo añade si falta.
pacman_conf="${root}/etc/pacman.conf"
if ! grep -q '^\[multilib\]' "$pacman_conf"; then
    if grep -q '^#\[multilib\]' "$pacman_conf"; then
        sed -i '/^#\[multilib\]/{s/^#//;n;s/^#Include/Include/}' "$pacman_conf"
    else
        printf '%s\n' '' '[multilib]' 'Include = /etc/pacman.d/mirrorlist' >>"$pacman_conf"
    fi
fi
repos=$(in_target pacman-conf --repo-list)
grep -qx multilib <<<"$repos" || { echo "prepare-target: multilib no quedó activo en pacman.conf." >&2; exit 1; }

# En la live el llavero de pacman vive en un tmpfs: la imagen lo trae vacío.
in_target pacman-key --init
in_target pacman-key --populate
# gpg-agent queda vivo dentro del destino e impediría desmontarlo al final.
in_target gpgconf --homedir /etc/pacman.d/gnupg --kill all || true

# La live arranca el escritorio por la línea de órdenes del kernel; el sistema instalado, por defecto.
in_target systemctl set-default graphical.target
