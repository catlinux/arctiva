#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Instala los controladores gráficos que pida arctiva-gpu (D-10). Lo ejecuta Calamares
# (shellprocess@drivers) desde la live, tras «packages» y antes de generar los initramfs.
# Nunca rompe la instalación: sin red o ante cualquier fallo avisa y sale con 0; el sistema
# se queda con el controlador libre (nouveau).
set -uo pipefail

root="${1:?uso: $0 <raíz-del-destino>}"

if ! curl -fsS --max-time 5 -o /dev/null http://ping.archlinux.org/nm-check.txt 2>/dev/null; then
    echo "install-drivers: sin conexión; se omiten los controladores gráficos."
    exit 0
fi

salida="$(arctiva-gpu --root "$root")" || { echo "install-drivers: arctiva-gpu falló; se omite."; exit 0; }
echo "$salida"
valor() { sed -n "s/^$1=//p" <<<"$salida"; }

read -r -a paquetes <<<"$(valor packages)"
read -r -a servicios <<<"$(valor services)"
(( ${#paquetes[@]} )) || exit 0

if ! chroot "$root" pacman -S --needed --noconfirm -- "${paquetes[@]}"; then
    echo "install-drivers: no se pudieron instalar ${paquetes[*]}; el sistema usará el controlador libre."
    exit 0
fi

# Los módulos NVIDIA en el initramfs (KMS temprano) y sin el hook kms, que los bloquearía.
# Los archivos de conf.d se cargan después del principal, así que este HOOKS prevalece.
if [[ "$(valor nvidia_kms)" == 1 ]]; then
    install -Dm644 /dev/stdin "${root}/etc/mkinitcpio.conf.d/arctiva-nvidia.conf" <<'CONF'
# Arctiva: KMS temprano de NVIDIA. Sin el hook kms, que cargaría nouveau antes.
MODULES+=(nvidia nvidia_modeset nvidia_uvm nvidia_drm)
HOOKS=(${HOOKS[@]/kms})
CONF
fi

for s in "${servicios[@]}"; do
    chroot "$root" systemctl enable "$s" || echo "install-drivers: no se pudo activar $s."
done
exit 0
