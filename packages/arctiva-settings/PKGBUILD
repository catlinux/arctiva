# SPDX-License-Identifier: GPL-3.0-or-later
# Maintainer: CatLinux
# Ajustes del sistema de Arctiva: zram, identidad en os-release, mirrors (reflector) y barra en varios monitores y aplicaciones
# que se instalan al conectarse (las que no caben en la ISO).
pkgname=arctiva-settings
pkgver=0.7.2
pkgrel=1
pkgdesc='Ajustes del sistema de Arctiva (zram, os-release, reflector, GRUB)'
arch=(any)
url='https://github.com/catlinux/arctiva'
license=(GPL-3.0-or-later)
depends=(zram-generator reflector plymouth networkmanager libnotify)
backup=(etc/arctiva/reflector.conf etc/pacman.d/arctiva-mirrorlist)
install=arctiva-settings.install

package() {
    cd -- "$startdir/files"
    install -Dm644 usr/lib/systemd/zram-generator.conf "$pkgdir/usr/lib/systemd/zram-generator.conf"
    install -Dm755 usr/lib/arctiva/update-os-release "$pkgdir/usr/lib/arctiva/update-os-release"
    install -Dm644 usr/share/libalpm/hooks/arctiva-os-release.hook \
        "$pkgdir/usr/share/libalpm/hooks/arctiva-os-release.hook"
    # Reinstala GRUB en la partición EFI cuando se actualiza el paquete grub (D-04).
    install -Dm755 usr/lib/arctiva/update-grub "$pkgdir/usr/lib/arctiva/update-grub"
    install -Dm644 usr/share/libalpm/hooks/arctiva-grub.hook \
        "$pkgdir/usr/share/libalpm/hooks/arctiva-grub.hook"
    # Plymouth en el initramfs del sistema instalado (no en la live).
    install -Dm644 etc/mkinitcpio.conf.d/arctiva-plymouth.conf         "$pkgdir/etc/mkinitcpio.conf.d/arctiva-plymouth.conf"
    # Fondo de la pantalla de inicio de sesión.
    install -Dm644 etc/plasmalogin.conf.d/arctiva-greeter.conf "$pkgdir/etc/plasmalogin.conf.d/arctiva-greeter.conf"
    install -Dm755 usr/lib/arctiva/update-grub-theme "$pkgdir/usr/lib/arctiva/update-grub-theme"
    install -Dm644 usr/share/libalpm/hooks/arctiva-grub-theme.hook         "$pkgdir/usr/share/libalpm/hooks/arctiva-grub-theme.hook"
    install -Dm644 etc/arctiva/reflector.conf "$pkgdir/etc/arctiva/reflector.conf"
    install -Dm644 etc/pacman.d/arctiva-mirrorlist "$pkgdir/etc/pacman.d/arctiva-mirrorlist"
    # Tema global y esquema de color por defecto de los usuarios nuevos (los existentes no cambian).
    install -Dm644 etc/xdg/kdeglobals "$pkgdir/etc/xdg/kdeglobals"
    install -Dm644 etc/xdg/ksplashrc "$pkgdir/etc/xdg/ksplashrc"
    # Bloq Num activado al iniciar la sesión (0 = activado en KDE), también en la live.
    install -Dm644 etc/xdg/kcminputrc "$pkgdir/etc/xdg/kcminputrc"
    install -Dm644 usr/lib/systemd/system/reflector.service.d/arctiva.conf         "$pkgdir/usr/lib/systemd/system/reflector.service.d/arctiva.conf"
    # Barra inferior también en los monitores adicionales (activada para todos los usuarios).
    install -Dm755 usr/lib/arctiva/ensure-panels "$pkgdir/usr/lib/arctiva/ensure-panels"
    install -Dm644 -t "$pkgdir/usr/lib/systemd/user" usr/lib/systemd/user/arctiva-panels.{service,timer}
    install -d -- "$pkgdir/usr/lib/systemd/user/timers.target.wants"
    ln -s ../arctiva-panels.timer "$pkgdir/usr/lib/systemd/user/timers.target.wants/arctiva-panels.timer"
    # Aplicaciones que no caben en la ISO: se instalan durante la instalación si hay red y, si no, en la
    # primera conexión (servicio + despachador de NetworkManager), con aviso al usuario.
    install -Dm644 usr/share/arctiva/deferred-packages "$pkgdir/usr/share/arctiva/deferred-packages"
    install -Dm755 usr/lib/arctiva/install-deferred "$pkgdir/usr/lib/arctiva/install-deferred"
    install -Dm755 usr/lib/arctiva/notify-deferred "$pkgdir/usr/lib/arctiva/notify-deferred"
    install -Dm644 usr/lib/systemd/system/arctiva-deferred.service         "$pkgdir/usr/lib/systemd/system/arctiva-deferred.service"
    install -d -- "$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
    ln -s ../arctiva-deferred.service "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/arctiva-deferred.service"
    install -Dm755 etc/NetworkManager/dispatcher.d/90-arctiva-deferred         "$pkgdir/etc/NetworkManager/dispatcher.d/90-arctiva-deferred"
    install -Dm644 -t "$pkgdir/usr/lib/systemd/user" usr/lib/systemd/user/arctiva-deferred-notify.{service,path}
    install -d -- "$pkgdir/usr/lib/systemd/user/paths.target.wants" "$pkgdir/usr/lib/systemd/user/default.target.wants"
    ln -s ../arctiva-deferred-notify.path "$pkgdir/usr/lib/systemd/user/paths.target.wants/arctiva-deferred-notify.path"
    ln -s ../arctiva-deferred-notify.service "$pkgdir/usr/lib/systemd/user/default.target.wants/arctiva-deferred-notify.service"
}
