# SPDX-License-Identifier: GPL-3.0-or-later
# Maintainer: CatLinux
# Ajustes del sistema de Arctiva: zram, identidad en os-release y mirrors (reflector).
pkgname=arctiva-settings
pkgver=0.1.1
pkgrel=1
pkgdesc='Ajustes del sistema de Arctiva (zram, os-release, reflector)'
arch=(any)
url='https://github.com/catlinux/arctiva'
license=(GPL-3.0-or-later)
depends=(zram-generator reflector)
backup=(etc/arctiva/reflector.conf etc/pacman.d/arctiva-mirrorlist)
install=arctiva-settings.install

package() {
    cd -- "$startdir/files"
    install -Dm644 usr/lib/systemd/zram-generator.conf "$pkgdir/usr/lib/systemd/zram-generator.conf"
    install -Dm755 usr/lib/arctiva/update-os-release "$pkgdir/usr/lib/arctiva/update-os-release"
    install -Dm644 usr/share/libalpm/hooks/arctiva-os-release.hook \
        "$pkgdir/usr/share/libalpm/hooks/arctiva-os-release.hook"
    install -Dm644 etc/arctiva/reflector.conf "$pkgdir/etc/arctiva/reflector.conf"
    install -Dm644 etc/pacman.d/arctiva-mirrorlist "$pkgdir/etc/pacman.d/arctiva-mirrorlist"
    install -Dm644 usr/lib/systemd/system/reflector.service.d/arctiva.conf         "$pkgdir/usr/lib/systemd/system/reflector.service.d/arctiva.conf"
}
