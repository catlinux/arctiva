# SPDX-License-Identifier: GPL-3.0-or-later
# Maintainer: CatLinux
# Arctiva Games: instala y ejecuta lanzadores y juegos de Windows con Wine. Opcional: se ofrece como extra en
# Arctiva Center. El código está en games/.
pkgname=arctiva-games
pkgver=0.2.0
pkgrel=1
pkgdesc='Arctiva Games: instala y ejecuta lanzadores y juegos de Windows con Wine'
arch=(any)
url='https://github.com/catlinux/arctiva'
license=(GPL-3.0-or-later)
depends=(python pyside6 qt6-declarative kirigami qqc2-desktop-style python-yaml wine winetricks umu-launcher)
makedepends=(qt6-tools)

prepare() {
    # build-packages.sh y publish-repo.sh dejan el código en ../games; en el repositorio está en ../../games.
    local d
    for d in "$startdir/../games" "$startdir/../../games"; do
        if [[ -e "$d/arctiva_games/__main__.py" ]]; then
            cp -a -- "$d" "$srcdir/games"
            return
        fi
    done
    echo 'arctiva-games: no se encuentra games/' >&2
    return 1
}

build() {
    cd -- "$srcdir/games"
    # lrelease no está en el PATH: vive en /usr/lib/qt6/bin.
    local ts
    for ts in translations/*.ts; do
        /usr/lib/qt6/bin/lrelease "$ts" -qm "${ts%.ts}.qm"
    done
}

package() {
    cd -- "$srcdir/games"
    local lib="$pkgdir/usr/lib/arctiva-games" share="$pkgdir/usr/share/arctiva-games"
    install -d -- "$lib"
    cp -a -- arctiva_games "$lib/"
    find "$lib" -name __pycache__ -prune -exec rm -rf -- {} +
    install -Dm755 bin/arctiva-games "$pkgdir/usr/bin/arctiva-games"
    install -d -- "$share"
    cp -a -- qml "$share/qml"
    install -Dm644 -t "$share" data/*.toml
    install -Dm644 -t "$share/translations" translations/*.qm
    install -Dm644 -t "$pkgdir/usr/share/applications" desktop/arctiva-games.desktop
}
