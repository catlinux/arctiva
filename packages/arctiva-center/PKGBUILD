# SPDX-License-Identifier: GPL-3.0-or-later
# Maintainer: CatLinux
# Arctiva Center: actualizaciones, controladores y extras (D-09). El código está en center/.
pkgname=arctiva-center
pkgver=0.7.11
pkgrel=1
pkgdesc='Centro de control de Arctiva: actualizaciones, controladores y extras'
arch=(any)
url='https://github.com/catlinux/arctiva'
license=(GPL-3.0-or-later)
depends=(python pyside6 qt6-declarative kirigami qqc2-desktop-style pacman-contrib fakeroot polkit libnotify git
         flatpak flatpak-kcm pyalpm archlinux-appstream-data arctiva-branding 'arctiva-hardware>=0.2.0')
makedepends=(qt6-tools)

prepare() {
    # build-packages.sh y publish-repo.sh dejan el código en ../center; en el repositorio está en ../../center.
    local d
    for d in "$startdir/../center" "$startdir/../../center"; do
        if [[ -e "$d/arctiva_center/__main__.py" ]]; then
            cp -a -- "$d" "$srcdir/center"
            return
        fi
    done
    echo 'arctiva-center: no se encuentra center/' >&2
    return 1
}

build() {
    cd -- "$srcdir/center"
    # lrelease no está en el PATH: vive en /usr/lib/qt6/bin.
    local ts
    for ts in translations/*.ts; do
        /usr/lib/qt6/bin/lrelease "$ts" -qm "${ts%.ts}.qm"
    done
}

package() {
    cd -- "$srcdir/center"
    local lib="$pkgdir/usr/lib/arctiva-center" share="$pkgdir/usr/share/arctiva-center"
    install -d -- "$lib"
    cp -a -- arctiva_center "$lib/"
    find "$lib" -name __pycache__ -prune -exec rm -rf -- {} +
    install -Dm755 bin/arctiva-center "$pkgdir/usr/bin/arctiva-center"
    # La ruta del ayudante es la de exec.path en la política polkit: no cambiar una sin la otra.
    install -Dm755 helper/arctiva-helper "$lib/arctiva-helper"
    install -Dm644 polkit/org.arctiva.center.policy \
        "$pkgdir/usr/share/polkit-1/actions/org.arctiva.center.policy"
    install -d -- "$share"
    cp -a -- qml "$share/qml"
    install -Dm644 -t "$share" data/*.toml
    install -Dm644 -t "$share/translations" translations/*.qm
    install -Dm644 -t "$pkgdir/usr/share/applications" desktop/arctiva-center.desktop
    # Doble clic en un .exe o .msi: diálogo para abrirlo con Bottles (D-12). El .desktop es
    # oculto y mimeapps.list lo deja como aplicación por defecto de esos tipos.
    install -Dm644 -t "$pkgdir/usr/share/applications" desktop/arctiva-windows-app.desktop
    install -Dm644 desktop/arctiva-mimeapps.list "$pkgdir/usr/share/applications/mimeapps.list"
    # Bienvenida al iniciar sesión: arctiva-center --welcome sale sin ventana si ya no toca.
    install -Dm644 -t "$pkgdir/etc/xdg/autostart" desktop/arctiva-center-welcome.desktop
    # Sustituye el lanzador de Discover del panel (el sistema instalado no lo lleva).
    install -Dm644 -t "$pkgdir/usr/share/plasma/shells/org.kde.plasma.desktop/contents/updates" \
        plasma/arctiva-center-launcher.js
    # Aviso periódico de actualizaciones, activado para todos los usuarios.
    install -Dm644 -t "$pkgdir/usr/lib/systemd/user" systemd/arctiva-center-check.{service,timer}
    install -d -- "$pkgdir/usr/lib/systemd/user/timers.target.wants"
    ln -s ../arctiva-center-check.timer \
        "$pkgdir/usr/lib/systemd/user/timers.target.wants/arctiva-center-check.timer"
}
