# Detección de hardware de Arctiva: de momento, las gráficas y sus controladores (D-10).
pkgname=arctiva-hardware
pkgver=0.1.0
pkgrel=1
pkgdesc='Detección de gráficas y controladores de Arctiva'
arch=(any)
url='https://github.com/catlinux/arctiva'
license=(GPL-3.0-or-later)
depends=(pciutils bash)

package() {
    install -Dm755 "$startdir/files/usr/bin/arctiva-gpu" "$pkgdir/usr/bin/arctiva-gpu"
}
