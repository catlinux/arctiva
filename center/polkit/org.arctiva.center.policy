<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Arctiva</vendor>
  <vendor_url>https://github.com/catlinux/arctiva</vendor_url>
  <icon_name>arctiva</icon_name>

  <action id="org.arctiva.center.helper">
    <description>Manage the system with Arctiva Center</description>
    <description xml:lang="es">Administrar el sistema con Arctiva Center</description>
    <description xml:lang="ca">Administrar el sistema amb Arctiva Center</description>
    <message>Authentication is required to update the system or to install or remove software</message>
    <message xml:lang="es">Se necesita autenticación para actualizar el sistema o instalar o quitar software</message>
    <message xml:lang="ca">Cal autenticació per actualitzar el sistema o instal·lar o treure programari</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/arctiva-center/arctiva-helper</annotate>
  </action>
</policyconfig>
