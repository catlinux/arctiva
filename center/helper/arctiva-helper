"""Ayudante privilegiado de Arctiva Center, lanzado con pkexec (acción org.arctiva.center.helper).

Solo acepta un conjunto cerrado de operaciones y nunca nombres de paquetes ni órdenes: los
paquetes y servicios salen de su propio catálogo, que es de root. Solo usa la biblioteca
estándar y no importa arctiva_center (-I deja fuera del sys.path el directorio del script).

Códigos de salida: el de pacman cuando es él quien falla; 64 uso o argumento no válido (no se
ejecuta nada); 65 hay actualizaciones pendientes (no se instalan dependencias del AUR);
69 herramienta no disponible; 70 catálogo ilegible; 75 base de pacman bloqueada;
77 sin permisos de root.
"""
import fnmatch
import os
import pwd
import re
import shutil
import stat
import subprocess
import sys
import tempfile
import tomllib
from collections import namedtuple

EX_USAGE, EX_DATAERR, EX_UNAVAILABLE, EX_SOFTWARE, EX_TEMPFAIL, EX_NOPERM = 64, 65, 69, 70, 75, 77

# Solo sin root, para las pruebas: todas las rutas cuelgan de este directorio. Con root (pkexec
# limpia además el entorno) se ignora siempre.
_test_root = os.environ.get("ARCTIVA_HELPER_TEST_ROOT", "") if os.geteuid() != 0 else ""
ROOT = os.path.realpath(_test_root) if _test_root else ""

BIN = ROOT + "/usr/bin"
ETC = ROOT + "/etc"
CATALOG = ROOT + "/usr/share/arctiva-center/extras.toml"
PROTECTED = ROOT + "/usr/share/arctiva-center/protected.toml"
VAR_TMP = ROOT + "/var/tmp"
# Base temporal de checkupdates: en un directorio de root, no en /var/tmp (con sticky bit, donde un
# usuario podría haber creado antes la ruta como enlace).
CHECK_DB = ROOT + "/var/cache/arctiva-center/checkupdates"
# Carpeta (bajo el home de quien llama) donde Arctiva Center compila los paquetes del AUR.
AUR_BUILD = ".cache/arctiva-center/aur/build"
DB_LOCK = ROOT + "/var/lib/pacman/db.lck"
INSTALL_DRIVERS = ROOT + "/usr/lib/arctiva/install-drivers"
GRUB_CFG = ROOT + "/boot/grub/grub.cfg"
# stdbuf hace que pacman escriba línea a línea aunque su salida sea una tubería.
STDBUF = "" if ROOT else "/usr/bin/stdbuf"

ID_RE = re.compile(r"[a-z0-9-]{1,40}")
PKG_RE = re.compile(r"[a-z0-9@_+][a-z0-9@._+-]*")
UNIT_RE = re.compile(r"[A-Za-z0-9@_][A-Za-z0-9@._:-]*\.(service|socket|timer|path)")
APP_PKG_RE = re.compile(r"[a-z0-9@_+][a-z0-9@._+-]{0,99}")
PKGFILE_RE = re.compile(r"[A-Za-z0-9@_+][A-Za-z0-9@._+-]*\.pkg\.tar\.zst")
MAX_PACKAGES = 20

USAGE = """uso: arctiva-helper <operación>
  update [--keyring-first]
  extra-install <id>
  extra-remove <id>
  drivers-apply
  pacnew-keep <ruta>
  pacnew-use <ruta>
  app-install <paquete>...
  app-remove <paquete>...
  aur-prepare
  aur-deps <paquete>...
  aur-install <archivo.pkg.tar.zst>..."""


class Refused(Exception):
    """Petición no válida: se sale con 64 sin haber ejecutado nada."""


def say(msg):
    print(f"arctiva-helper: {msg}", flush=True)


def run(*cmd):
    argv = [STDBUF, "-oL", "-eL", *cmd] if STDBUF and os.path.exists(STDBUF) else list(cmd)
    say("$ " + " ".join(cmd))
    # Mensajes en inglés: Arctiva Center reconoce los errores por su texto y los explica traducidos.
    env = {k: v for k, v in os.environ.items() if k != "LANGUAGE"}
    env["LC_ALL"] = "C.UTF-8"
    return subprocess.run(argv, stdin=subprocess.DEVNULL, env=env).returncode


def pacman(*args):
    return run(BIN + "/pacman", *args)


def systemctl(*args):
    return run(BIN + "/systemctl", *args)


Extra = namedtuple("Extra", "packages services remove_also with_drivers update_grub others")


def _names(value, regex, allow_empty=True):
    """La lista si todos sus elementos casan con regex; si no, None."""
    if not isinstance(value, list) or (not value and not allow_empty):
        return None
    if not all(isinstance(v, str) and regex.fullmatch(v) for v in value):
        return None
    return value


def load_extra(extra_id):
    if not ID_RE.fullmatch(extra_id):
        raise Refused(f"identificador no válido: {extra_id!r}")
    try:
        with open(CATALOG, "rb") as f:
            catalog = tomllib.load(f)
    except (OSError, tomllib.TOMLDecodeError) as e:
        say(f"no se puede leer el catálogo: {e}")
        sys.exit(EX_SOFTWARE)
    extras = [e for e in catalog.get("extra", []) if isinstance(e, dict)] \
        if isinstance(catalog.get("extra"), list) else []
    for extra in extras:
        if extra.get("id") == extra_id:
            break
    else:
        raise Refused(f"el extra {extra_id!r} no está en el catálogo")
    # El catálogo es de root, pero se valida igual: nada que pueda leerse como una opción.
    packages = _names(extra.get("packages"), PKG_RE, allow_empty=False)
    remove_also = _names(extra.get("remove_also", []), PKG_RE)
    services = _names(extra.get("services", []), UNIT_RE)
    if packages is None or remove_also is None:
        raise Refused(f"paquetes no válidos en el extra {extra_id!r}")
    if services is None:
        raise Refused(f"servicios no válidos en el extra {extra_id!r}")
    # Paquetes de los demás extras: al quitar este, no se tocan los que otro siga usando.
    others = [set(p) for e in extras if e is not extra
              for p in [_names(e.get("packages"), PKG_RE, allow_empty=False)] if p]
    return Extra(packages, services, remove_also, extra.get("with_drivers") is True,
                 extra.get("update_grub") is True, others)


def installed_packages():
    out = subprocess.run([BIN + "/pacman", "-Qq"], stdin=subprocess.DEVNULL,
                         capture_output=True, text=True, env=dict(os.environ, LC_ALL="C.UTF-8"))
    return set(out.stdout.split()) if out.returncode == 0 else set()


def update_grub():
    # Un kernel nuevo o quitado no aparece en el menú hasta regenerar grub.cfg.
    if not os.path.exists(GRUB_CFG):
        say("no hay /boot/grub/grub.cfg: no se regenera el menú de arranque")
        return 0
    return run(BIN + "/grub-mkconfig", "-o", GRUB_CFG)


def pacnew_paths(path):
    """Devuelve (pacnew, original) ya resueltos, o rechaza la ruta."""
    if not path.startswith("/") or not path.endswith(".pacnew") or "\0" in path:
        raise Refused(f"ruta no válida: {path!r}")
    real = os.path.realpath(path)
    # Con enlaces o «..» en cualquier punto, la ruta resuelta no coincide con la pedida.
    if real != path or not real.startswith(ETC + "/"):
        raise Refused(f"la ruta debe ser un .pacnew dentro de /etc, sin enlaces: {path!r}")
    st = os.lstat(real) if os.path.lexists(real) else None
    if st is None or not stat.S_ISREG(st.st_mode):
        raise Refused(f"no es un archivo normal: {path!r}")
    original = real[: -len(".pacnew")]
    st = os.lstat(original) if os.path.lexists(original) else None
    if st is None or not stat.S_ISREG(st.st_mode):
        raise Refused(f"no existe el archivo original de {path!r}")
    return real, original


def drivers_apply():
    if not os.access(INSTALL_DRIVERS, os.X_OK):
        say("install-drivers no está disponible en este sistema")
        return EX_UNAVAILABLE
    return run(INSTALL_DRIVERS, "--upgrade", ROOT or "/")


def op_update(args):
    if args not in ([], ["--keyring-first"]):
        raise Refused("update solo admite --keyring-first")
    check_lock()
    if args:
        # Nunca un -Sy suelto: le sigue siempre -Su.
        rc = pacman("-Sy", "--needed", "--noconfirm", "archlinux-keyring")
        return rc or pacman("-Su", "--noconfirm")
    return pacman("-Syu", "--noconfirm")


def op_extra_install(args):
    extra = load_extra(one_arg(args))
    check_lock()
    rc = pacman("-Syu", "--needed", "--noconfirm", "--", *extra.packages)
    for unit in extra.services:
        rc = rc or systemctl("enable", "--now", "--", unit)
    # Controladores después (con linux-lts ya instalado, arctiva-gpu pide nvidia-open-lts) y el
    # menú de GRUB al final, con los initramfs ya generados.
    if not rc and extra.with_drivers:
        rc = drivers_apply()
    if not rc and extra.update_grub:
        rc = update_grub()
    return rc


def op_extra_remove(args):
    extra = load_extra(one_arg(args))
    check_lock()
    installed = installed_packages()
    keep = set().union(*[o for o in extra.others if o <= installed])
    targets = [p for p in dict.fromkeys(extra.packages + extra.remove_also)
               if p in installed and p not in keep]
    if not targets:
        say("no hay nada que quitar")
        return 0
    # Primero se comprueba que se puede quitar (otro paquete puede depender de él): si no, no
    # se ha tocado ningún servicio. --print no admite -n (--nosave): la simulación va sin él.
    rc = run(BIN + "/pacman", "-Rs", "--print", "--", *targets)
    if rc:
        return rc
    for unit in extra.services:
        systemctl("disable", "--now", "--", unit)
    rc = pacman("-Rns", "--noconfirm", "--", *targets)
    if not rc and extra.update_grub:
        rc = update_grub()
    return rc


def op_drivers_apply(args):
    if args:
        raise Refused("drivers-apply no admite argumentos")
    check_lock()
    return drivers_apply()


def capture(*cmd):
    """Orden cuya salida se lee (no se muestra): (código, salida)."""
    p = subprocess.run(list(cmd), stdin=subprocess.DEVNULL, capture_output=True, text=True,
                       env=dict(os.environ, LC_ALL="C.UTF-8"))
    return p.returncode, p.stdout


def package_names(args):
    """Entre 1 y 20 nombres de paquete válidos y sin repetir; si no, rechaza. Ninguno puede
    leerse como una opción de pacman (no empiezan por «-»)."""
    if not args or len(args) > MAX_PACKAGES:
        raise Refused(f"se esperaban entre 1 y {MAX_PACKAGES} paquetes")
    for name in args:
        if not APP_PKG_RE.fullmatch(name):
            raise Refused(f"nombre de paquete no válido: {name!r}")
    return list(dict.fromkeys(args))


def protected_patterns():
    try:
        with open(PROTECTED, "rb") as f:
            patterns = tomllib.load(f).get("patterns")
    except (OSError, tomllib.TOMLDecodeError) as e:
        say(f"no se puede leer la lista de paquetes protegidos: {e}")
        sys.exit(EX_SOFTWARE)
    if not isinstance(patterns, list) or not patterns or not all(isinstance(p, str) for p in patterns):
        say("la lista de paquetes protegidos no es válida")
        sys.exit(EX_SOFTWARE)
    return patterns


def is_protected(name, patterns):
    return any(fnmatch.fnmatchcase(name, p) for p in patterns)


def op_app_install(args):
    packages = package_names(args)
    check_lock()
    # Siempre -Syu: nunca se refresca la base sin actualizar el sistema entero (D-07).
    return pacman("-Syu", "--needed", "--noconfirm", "--", *packages)


def op_app_remove(args):
    packages = package_names(args)
    patterns = protected_patterns()
    blocked = [p for p in packages if is_protected(p, patterns)]
    if blocked:
        raise Refused("paquetes protegidos: " + ", ".join(blocked))
    check_lock()
    rc, out = capture(BIN + "/pacman", "-Qqe")
    explicit = set(out.split()) if rc == 0 else set()
    missing = [p for p in packages if p not in explicit]
    if missing:
        raise Refused("no están instalados de forma explícita: " + ", ".join(missing))
    # Lo que se llevaría -Rs (las dependencias que nadie más necesita) tampoco puede ser protegido.
    rc, out = capture(BIN + "/pacman", "-Rs", "--print", "--print-format", "%n", "--", *packages)
    if rc:
        say("pacman no puede quitarlos (otro paquete los necesita)")
        return rc
    removed = [n for n in out.split() if n]
    blocked = [n for n in removed if is_protected(n, patterns)]
    if blocked:
        raise Refused("quitarlos arrastraría paquetes protegidos: " + ", ".join(blocked))
    return pacman("-Rns", "--noconfirm", "--", *packages)


def pending_updates():
    """True si hay actualizaciones pendientes (base temporal de checkupdates, nunca la real)."""
    env = dict(os.environ, CHECKUPDATES_DB=CHECK_DB, LC_ALL="C.UTF-8")
    os.makedirs(os.path.dirname(CHECK_DB), mode=0o755, exist_ok=True)
    os.makedirs(CHECK_DB, mode=0o700, exist_ok=True)
    st = os.lstat(CHECK_DB)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.geteuid() or st.st_mode & 0o022:
        say("la base temporal de comprobación no es de confianza: no se comprueban actualizaciones")
        sys.exit(EX_TEMPFAIL)
    p = subprocess.run([BIN + "/checkupdates"], stdin=subprocess.DEVNULL, capture_output=True,
                       text=True, env=env)
    if p.returncode == 0:
        return True
    if p.returncode == 2:
        return False
    say("no se ha podido comprobar si hay actualizaciones pendientes")
    sys.exit(EX_TEMPFAIL)


def op_aur_prepare(args):
    if args:
        raise Refused("aur-prepare no admite argumentos")
    check_lock()
    # Lo que makepkg necesita para compilar paquetes del AUR.
    return pacman("-Syu", "--needed", "--noconfirm", "--", "base-devel", "git")


def op_aur_deps(args):
    packages = package_names(args)
    check_lock()
    if pending_updates():
        say("hay actualizaciones pendientes: actualiza el sistema antes de instalar dependencias")
        return EX_DATAERR
    return pacman("-S", "--needed", "--asdeps", "--noconfirm", "--", *packages)


def caller_uid():
    try:
        uid = int(os.environ["PKEXEC_UID"])
    except (KeyError, ValueError):
        raise Refused("no se sabe quién llama (se lanza con pkexec)")
    if uid <= 0 and not ROOT:
        raise Refused("quien llama no puede ser root")
    return uid


def aur_build_dir(uid):
    if ROOT:
        return os.path.join(ROOT, "home", "user", AUR_BUILD)
    try:
        home = pwd.getpwuid(uid).pw_dir
    except KeyError:
        raise Refused("no existe el usuario que llama")
    return os.path.join(home, AUR_BUILD)


def aur_package_files(args, uid):
    """Valida los paquetes ya compilados: archivos normales .pkg.tar.zst de quien llama, dentro de
    su carpeta de compilación y sin enlaces simbólicos."""
    if not args or len(args) > 2 * MAX_PACKAGES:
        raise Refused("se esperaban entre 1 y 40 archivos")
    build = aur_build_dir(uid)
    if os.path.realpath(build) != build:
        raise Refused("la carpeta de compilación del AUR no puede contener enlaces simbólicos")
    files = []
    for path in dict.fromkeys(args):
        if "\0" in path or not PKGFILE_RE.fullmatch(os.path.basename(path)):
            raise Refused(f"archivo no válido: {path!r}")
        if os.path.realpath(path) != path or not path.startswith(build + "/"):
            raise Refused(f"el archivo debe estar en {build}, sin enlaces: {path!r}")
        st = os.lstat(path) if os.path.lexists(path) else None
        if st is None or not stat.S_ISREG(st.st_mode):
            raise Refused(f"no es un archivo normal: {path!r}")
        if st.st_uid != uid:
            raise Refused(f"el archivo no es de quien llama: {path!r}")
        files.append(path)
    return files


def op_aur_install(args):
    uid = caller_uid()
    files = aur_package_files(args, uid)
    check_lock()
    # Se instala una copia que root hace en un directorio propio: así el usuario no puede
    # cambiar el archivo entre la comprobación y pacman -U.
    os.makedirs(VAR_TMP, exist_ok=True)
    work = tempfile.mkdtemp(prefix="arctiva-aur-", dir=VAR_TMP)
    try:
        copies = []
        for path in files:
            fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
            with os.fdopen(fd, "rb") as src:
                st = os.fstat(src.fileno())
                if not stat.S_ISREG(st.st_mode) or st.st_uid != uid:
                    raise Refused(f"el archivo ha cambiado: {path!r}")
                dest = os.path.join(work, os.path.basename(path))
                with open(dest, "xb") as out:
                    shutil.copyfileobj(src, out)
            copies.append(dest)
        return pacman("-U", "--needed", "--noconfirm", "--", *copies)
    finally:
        shutil.rmtree(work, ignore_errors=True)


def op_pacnew_keep(args):
    pacnew, _ = pacnew_paths(one_arg(args))
    check_lock()
    os.unlink(pacnew)
    say(f"borrado {pacnew}; se conserva la versión actual")
    return 0


def op_pacnew_use(args):
    pacnew, original = pacnew_paths(one_arg(args))
    pacsave = original + ".pacsave"
    if os.path.lexists(pacsave):
        if not stat.S_ISREG(os.lstat(pacsave).st_mode):
            raise Refused(f"{pacsave} existe y no es un archivo normal")
    check_lock()
    # La copia de la versión actual es un enlace duro y la sustitución, un rename atómico: si
    # algo falla a medias, el original sigue en su sitio.
    if os.path.lexists(pacsave):
        os.unlink(pacsave)
    os.link(original, pacsave)
    os.replace(pacnew, original)
    say(f"{original} sustituido por la versión nueva; la anterior queda en {original}.pacsave")
    return 0


def one_arg(args):
    if len(args) != 1:
        raise Refused("se esperaba un argumento")
    return args[0]


def check_lock():
    if os.path.lexists(DB_LOCK):
        say("pacman está en uso (existe /var/lib/pacman/db.lck); inténtalo más tarde")
        sys.exit(EX_TEMPFAIL)


OPERATIONS = {
    "update": op_update,
    "extra-install": op_extra_install,
    "extra-remove": op_extra_remove,
    "drivers-apply": op_drivers_apply,
    "pacnew-keep": op_pacnew_keep,
    "pacnew-use": op_pacnew_use,
    "app-install": op_app_install,
    "app-remove": op_app_remove,
    "aur-prepare": op_aur_prepare,
    "aur-deps": op_aur_deps,
    "aur-install": op_aur_install,
}


def main(argv):
    if os.geteuid() != 0 and not ROOT:
        say("necesita permisos de root (se lanza con pkexec)")
        return EX_NOPERM
    if len(argv) < 2 or argv[1] not in OPERATIONS:
        print(USAGE, file=sys.stderr)
        return EX_USAGE
    try:
        return OPERATIONS[argv[1]](argv[2:])
    except Refused as e:
        say(str(e))
        return EX_USAGE
    except OSError as e:
        say(f"error del sistema: {e}")
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
